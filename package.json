{
  "name": "cyber-roadmap-platform",
  "version": "1.0.0",
  "description": "A collaborative cybersecurity learning platform with structured roadmaps, realtime chat, and progress tracking.",
  "main": "src/scripts/script.js",
  "scripts": {
    "dev": "http-server dist -p 8000 -c-1 --cors",
    "build": "node build.js",
    "start": "npm run build && npm run dev",
    "watch": "nodemon -e html,css,js -x \"npm run build\"",
    "deploy": "npm run build && firebase deploy",
    "serve": "firebase serve",
    "lint": "eslint src/scripts/*.js --fix",
    "clean": "rm -rf dist/*",
    "test": "echo \"No tests specified\" && exit 0"
  },
  "keywords": [
    "cybersecurity",
    "learning",
    "roadmap",
    "education",
    "firebase",
    "realtime"
  ],
  "author": "Cyber Roadmap Team",
  "license": "MIT",
  "devDependencies": {
    "clean-css-cli": "^5.6.1",
    "http-server": "^14.1.1",
    "nodemon": "^2.0.22",
    "onchange": "^7.1.0",
    "uglify-js": "^3.17.4",
    "eslint": "^8.37.0"
  },
  "engines": {
    "node": ">=16.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/yourusername/cyber-roadmap-platform.git"
  },
  "bugs": {
    "url": "https://github.com/yourusername/cyber-roadmap-platform/issues"
  },
  "homepage": "https://yourusername.github.io/cyber-roadmap-platform"
}